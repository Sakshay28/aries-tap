# ─────────────────────────────────────────────────────────────
# Aries Tap — WiFi OTP + lead capture
# Copy to .env.local for dev, or set these in Vercel for production.
# The app runs WITHOUT any of these in dev (in-memory store, JSON leads,
# OTP printed to the server log). Set them all before go-live.
# ─────────────────────────────────────────────────────────────

# Postgres for durable leads (Neon or Vercel Postgres). Unset → leads are
# written to ./.data/leads.json so the admin dashboard still works locally.
DATABASE_URL=

# Upstash Redis (REST) for OTP storage + rate limiting. Unset → in-memory
# fallback (fine for a single dev process, NOT for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Aries automation endpoint that relays the OTP over the official WhatsApp
# Business Cloud API using the approved `wifi_otp` authentication template.
# Unset → dev fallback logs the code and shows it in the UI.
# Aries receives: { phone, code, channel:"whatsapp", template:"wifi_otp",
#                   venue, ttlSeconds }  with  Authorization: Bearer <key>
ARIES_OTP_WEBHOOK_URL=
ARIES_API_KEY=

# Secret used to sign verification + admin session cookies (HMAC).
# REQUIRED in production. Generate: openssl rand -hex 32
WIFI_SESSION_SECRET=

# Admin dashboard password (/admin). Dev default is "admin" when unset.
ADMIN_PASSWORD=

# Cloudflare Turnstile (bot defence on the phone step). Optional but strongly
# recommended before launch to stop OTP-bombing. Both must be set to enable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Consent policy version stored with each lead (bump when the policy changes).
CONSENT_VERSION=2026-08-05

# ─────────────────────────────────────────────────────────────
# Review Experience (⭐ Leave a Review)
# The whole feature runs with NONE of these set: reviews + events go to
# ./.data/*.json, AI triage uses the built-in heuristic, photos are kept inline,
# and no alerts are sent. Wire these for production. It reuses DATABASE_URL,
# UPSTASH_* (rate limit + duplicate detection), WIFI_SESSION_SECRET (IP hashing +
# admin cookie), ADMIN_PASSWORD (/admin/reviews), and TURNSTILE_* (bot defence)
# from above — nothing to duplicate.
# ─────────────────────────────────────────────────────────────

# Google Gemini for feedback triage (summary, priority, department, severity,
# sentiment, suggested reply). Unset → deterministic keyword heuristic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Private object storage for feedback photos. Unset → the validated, compressed
# data URL is stored inline in Postgres (fine for low volume; not archival).
# The webhook receives { filename (uuid), contentType, data:<dataURL> } with
# Authorization: Bearer <token> and must return { url } (ideally a signed URL).
REVIEW_UPLOAD_WEBHOOK_URL=
REVIEW_UPLOAD_TOKEN=

# Optional antivirus gateway. Receives { image:<dataURL> }, returns { clean }.
# Unset → skipped. Configured but unreachable → the image is rejected (fail closed).
REVIEW_VIRUS_SCAN_URL=

# New-feedback alerts (email now; WhatsApp/push later). Receives the summarized
# payload with Authorization: Bearer <token>. Unset → logged to the server only.
REVIEW_NOTIFY_WEBHOOK_URL=
REVIEW_NOTIFY_TOKEN=

# How long an identical submission from the same device is treated as a
# duplicate (seconds). Default 6h.
REVIEW_DUPLICATE_WINDOW_SECONDS=21600

# ─────────────────────────────────────────────────────────────
# Play & Win (🎮 tap-to-play rewards)
# Runs with NOTHING extra to configure: plays + claims go to ./.data/*.json,
# rate-limit/daily-gate counters use the in-memory store, and rewards are signed
# with the dev key. It reuses DATABASE_URL (playwin_plays + playwin_claims),
# UPSTASH_* (cooldowns + per-game daily limit + per-phone claim cap),
# WIFI_SESSION_SECRET (signs the play proof + the reward QR + hashes devices/IPs),
# and ADMIN_PASSWORD (/admin/play + staff redemption at /r/<token>) from above.
# The prize table, odds and enabled games are authored in src/lib/content.ts
# (`playwin`) — no env, no code changes to run it.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Live Owner Dashboard (/admin/overview) + unified event stream
# Runs with NOTHING extra: NFC taps, WhatsApp clicks, page views and reviews all
# land in the `tap_events` table (or ./.data/tap_events.json without a DB) and
# stream to the dashboard over Server-Sent Events via an in-process broker. It
# reuses DATABASE_URL (durable events + SQL-side aggregation), UPSTASH_* (ingest
# rate limiting), WIFI_SESSION_SECRET (signs the admin cookie + hashes IPs) and
# ADMIN_PASSWORD (gates /admin/overview) from above — nothing to duplicate.
# ─────────────────────────────────────────────────────────────

# Realtime transport. Unset → the in-process SSE broker (perfect locally and for
# a single always-warm instance; across multiple serverless instances a live
# event can miss a dashboard held open on another instance — the DB-cursor
# resync on the next reconnect closes the gap, so data is never wrong, only a few
# seconds late in that edge case). Set ARIES_REALTIME=ably + ABLY_API_KEY to fan
# out over a managed pub/sub for bulletproof multi-instance scale (see
# src/lib/realtime/bus.ts).
ARIES_REALTIME=
ABLY_API_KEY=

# How long two writes carrying the same idempotency key collapse to one row
# (double-tapped CTA, retried beacon). Default 10 minutes.
EVENT_IDEMPOTENCY_WINDOW_SECONDS=600
